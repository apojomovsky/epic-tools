 #include "PIC32PE.h"
 
-#ifdef __linux__
-/* linux gcc produces warnings for almost concats in this file, removing it as they seem all safe */
-static char * _tcsncat_s(char *dst, const char *src, size_t len)
+/* The CRT secure form wants a buffer size the call sites do not carry, so every
+   host funnels through this strncat spelling instead of the platform one. */
+static char *hex_cat(char *dst, const char *src, size_t len)
 {
+#ifdef __GNUC__
 #pragma GCC diagnostic push
 #pragma GCC diagnostic ignored "-Wstringop-truncation"
+#endif
 	return strncat(dst, src, len);
+#ifdef __GNUC__
 #pragma GCC diagnostic pop
-}
 #endif
+}
 
